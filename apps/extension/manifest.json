{
  "manifest_version": 3,
  "name": "FaultLab",
  "version": "0.1.0",
  "description": "Controlled network and JSON failure injection for local web application testing.",
  "minimum_chrome_version": "114",
  "permissions": ["debugger", "storage", "sidePanel", "tabs"],
  "action": { "default_title": "Open FaultLab side panel" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" }
}
